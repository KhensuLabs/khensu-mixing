<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Opts the process in to Win32 paths longer than MAX_PATH (260 chars).
     Effective only when the machine policy LongPathsEnabled=1 is set
     (Windows 10 1607+, on by default on newer installs). Merged by the MSVC
     linker/mt.exe with the default manifest. A VST3 plugin cannot opt in:
     long-path awareness is per process, i.e. the host DAW's manifest. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings xmlns:ws2="http://schemas.microsoft.com/SMI/2016/WindowsSettings">
      <ws2:longPathAware>true</ws2:longPathAware>
    </windowsSettings>
  </application>
</assembly>
