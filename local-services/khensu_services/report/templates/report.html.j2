<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Khensu Analysis Report -- {{ session_name }}</title>
  <style>
    :root {
      --bg-void: {{ theme.bg_void }}; --bg-base: {{ theme.bg_base }};
      --bg-surface: {{ theme.bg_surface }}; --bg-raised: {{ theme.bg_raised }};
      --bg-overlay: {{ theme.bg_overlay }}; --border-subtle: {{ theme.border_subtle }};
      --border-active: {{ theme.border_active }}; --accent-teal: {{ theme.accent_teal }};
      --accent-teal-dim: {{ theme.accent_teal_dim }}; --accent-amber: {{ theme.accent_amber }};
      --accent-amber-dim: {{ theme.accent_amber_dim }}; --accent-red: {{ theme.accent_red }};
      --accent-red-dim: {{ theme.accent_red_dim }}; --accent-purple: {{ theme.accent_purple }};
      --accent-purple-dim: {{ theme.accent_purple_dim }}; --accent-magenta: {{ theme.accent_magenta }};
      --accent-magenta-dim: {{ theme.accent_magenta_dim }}; --accent-blue: {{ theme.accent_blue }};
      --accent-blue-dim: {{ theme.accent_blue_dim }}; --accent-green: {{ theme.accent_green }};
      --accent-green-dim: {{ theme.accent_green_dim }}; --scrim: {{ theme.scrim }};
      --shadow-colour: {{ theme.shadow_colour }}; --highlight: {{ theme.highlight }};
      --focus-ring: {{ theme.focus_ring }}; --text-primary: {{ theme.text_primary }};
      --text-secondary: {{ theme.text_secondary }}; --text-tertiary: {{ theme.text_tertiary }};
      --text-accent: {{ theme.text_accent }};
    }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
           background: var(--bg-base); color: var(--text-primary); margin: 0; padding: 24px; }
    h1   { color: var(--text-accent); margin: 0 0 8px 0; font-size: 24px; }
    .header  { background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: 8px; padding: 24px; margin-bottom: 20px; }
    .meta    { color: var(--text-secondary); font-size: 13px; }
    .section { background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: 8px; padding: 20px; margin-bottom: 16px; }
    .section h2 { color: var(--text-accent); font-size: 14px; margin: 0 0 16px 0;
                  text-transform: uppercase; letter-spacing: 1px; }
    .metrics { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 12px; }
    .metric  { background: var(--bg-raised); border: 1px solid var(--border-subtle); border-radius: 6px; padding: 12px; }
    .metric .label { color: var(--text-secondary); font-size: 11px; text-transform: uppercase;
                     letter-spacing: 0.5px; margin-bottom: 4px; }
    .metric .value { color: var(--text-primary); font-size: 20px; font-weight: 600; }
    .metric .unit  { color: var(--text-secondary); font-size: 12px; }
    .badge      { display: inline-block; padding: 2px 8px; border-radius: 3px;
                  font-size: 11px; font-weight: 600; text-transform: uppercase; }
    .badge-pass { background: var(--accent-green-dim); color: var(--accent-green); }
    .badge-warn { background: var(--accent-amber-dim); color: var(--accent-amber); }
    .badge-fail { background: var(--accent-red-dim); color: var(--accent-red); }
    table       { width: 100%; border-collapse: collapse; }
    thead th    { text-align: left; padding: 8px 12px; color: var(--text-secondary);
                  font-size: 11px; text-transform: uppercase;
                  border-bottom: 1px solid var(--border-active); }
    tbody td    { padding: 10px 12px; border-bottom: 1px solid var(--border-subtle);
                  font-size: 13px; vertical-align: top; }
    tbody tr:last-child td { border-bottom: none; }
    .footer     { text-align: center; color: var(--text-tertiary); font-size: 11px; margin-top: 32px; }
  </style>
</head>
<body>
  <div class="header">
    <h1>Analysis Report: {{ session_name }}</h1>
    <div class="meta">File: {{ file_name }} &nbsp;|&nbsp; Generated: {{ computed_at }}</div>
  </div>

  <div class="section">
    <h2>Loudness &amp; Dynamics</h2>
    <div class="metrics">
      <div class="metric">
        <div class="label">Integrated LUFS</div>
        <div class="value">{{ "%.1f"|format(lufs_integrated) }}<span class="unit"> LUFS</span></div>
      </div>
      <div class="metric">
        <div class="label">Loudness Range</div>
        <div class="value">{{ "%.1f"|format(lra) }}<span class="unit"> LU</span></div>
      </div>
      <div class="metric">
        <div class="label">True Peak</div>
        <div class="value">{{ "%.1f"|format(true_peak_dbtp) }}<span class="unit"> dBTP</span></div>
      </div>
      <div class="metric">
        <div class="label">Crest Factor</div>
        <div class="value">{{ "%.1f"|format(crest_factor_db) }}<span class="unit"> dB</span></div>
      </div>
      <div class="metric">
        <div class="label">Dynamic Range</div>
        <div class="value">{{ "%.1f"|format(dynamic_range_db) }}<span class="unit"> DR</span></div>
      </div>
      <div class="metric">
        <div class="label">Stereo Width</div>
        <div class="value">{{ "%.0f"|format(stereo_width * 100) }}<span class="unit"> %</span></div>
      </div>
      {% if stereo_correlation %}
      <div class="metric">
        <div class="label">Stereo Correlation</div>
        <div class="value">{{ "%.2f"|format(stereo_correlation) }}</div>
      </div>
      {% endif %}
    </div>
  </div>

  {% if spectral_balance_low or spectral_balance_mid or spectral_balance_high %}
  <div class="section">
    <h2>Spectral Balance</h2>
    <div style="margin-bottom:12px;font-size:12px;color:var(--text-secondary);">Centroid: {{ "%.0f"|format(spectral_centroid_hz) }} Hz</div>
    {% for label, val, colour in [("Low (20–250 Hz)", spectral_balance_low, theme.accent_teal),
                                   ("Mid (250 Hz–4 kHz)", spectral_balance_mid, theme.accent_blue),
                                   ("High (4–20 kHz)", spectral_balance_high, theme.accent_amber)] %}
    <div style="margin-bottom:10px;">
      <div style="display:flex;justify-content:space-between;font-size:11px;color:var(--text-secondary);margin-bottom:3px;">
        <span>{{ label }}</span><span>{{ "%.0f"|format(val * 100) }}%</span>
      </div>
      <div style="background:var(--bg-raised);border-radius:3px;height:8px;overflow:hidden;">
        <div style="background:{{ colour }};height:100%;width:{{ "%.0f"|format(val * 100) }}%;border-radius:3px;"></div>
      </div>
    </div>
    {% endfor %}
    {% if harshness_score > 0 %}
    <div style="margin-top:12px;" class="metrics">
      <div class="metric">
        <div class="label">Harshness Score</div>
        <div class="value">{{ "%.0f"|format(harshness_score * 100) }}<span class="unit"> %</span></div>
      </div>
      {% if harshness_peak_hz %}
      <div class="metric">
        <div class="label">Harsh Peak</div>
        <div class="value" style="font-size:16px;">{{ "%.0f"|format(harshness_peak_hz) }}<span class="unit"> Hz</span></div>
      </div>
      {% endif %}
    </div>
    {% endif %}
  </div>
  {% endif %}

  {% if translation_risk_studio or translation_risk_earbuds or translation_risk_phone or translation_risk_car or translation_risk_club %}
  <div class="section">
    <h2>Translation Risk</h2>
    <div style="font-size:11px;color:var(--text-secondary);margin-bottom:12px;">Higher = greater risk of poor playback in that environment.</div>
    {% for label, val in [("Studio",  translation_risk_studio),
                          ("Earbuds", translation_risk_earbuds),
                          ("Phone",   translation_risk_phone),
                          ("Car",     translation_risk_car),
                          ("Club",    translation_risk_club)] %}
    {% set colour = theme.accent_green if val < 0.3 else (theme.accent_amber if val < 0.6 else theme.accent_red) %}
    <div style="margin-bottom:10px;">
      <div style="display:flex;justify-content:space-between;font-size:11px;color:var(--text-secondary);margin-bottom:3px;">
        <span>{{ label }}</span><span style="color:{{ colour }};">{{ "%.0f"|format(val * 100) }}%</span>
      </div>
      <div style="background:var(--bg-raised);border-radius:3px;height:8px;overflow:hidden;">
        <div style="background:{{ colour }};height:100%;width:{{ "%.0f"|format(val * 100) }}%;border-radius:3px;"></div>
      </div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if resonance_hotspots %}
  <div class="section">
    <h2>Resonance Hotspots</h2>
    <table>
      <thead><tr><th>Frequency</th><th>Level</th><th>Prominence</th></tr></thead>
      <tbody>
        {% for h in resonance_hotspots %}
        <tr>
          <td>{{ "%.0f"|format(h.hz) }} Hz</td>
          <td>{{ "%.1f"|format(h.db) }} dB</td>
          <td>
            {% if h.prominence >= 15 %}<span class="badge badge-fail">
            {% elif h.prominence >= 10 %}<span class="badge badge-warn">
            {% else %}<span class="badge badge-pass">{% endif %}
            {{ "%.1f"|format(h.prominence) }} dB</span>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  <div class="section">
    <h2>Musical Characteristics</h2>
    {% if estimate_caveat %}<p class="caveat"><em>{{ estimate_caveat }}</em></p>{% endif %}
    <div class="metrics">
      {% if bpm > 0 %}
      <div class="metric">
        <div class="label">BPM</div>
        <div class="value">{{ "%.1f"|format(bpm) }}</div>
        {% if bpm_confidence is not none %}<div class="label">confidence {{ "%.0f"|format(bpm_confidence * 100) }} %</div>{% endif %}
      </div>
      {% endif %}
      {% if pitch_key %}
      <div class="metric">
        <div class="label">Key</div>
        <div class="value" style="font-size:16px;">{{ pitch_key }}</div>
        {% if key_confidence is not none %}<div class="label">confidence {{ "%.0f"|format(key_confidence * 100) }} %</div>{% endif %}
      </div>
      {% endif %}
      {% if genre_detected %}
      <div class="metric">
        <div class="label">Genre</div>
        <div class="value" style="font-size:14px;">{{ genre_detected }}</div>
      </div>
      {% endif %}
      {% if hook_strength > 0 %}
      <div class="metric">
        <div class="label">Hook Strength</div>
        <div class="value">{{ "%.0f"|format(hook_strength * 100) }}<span class="unit"> %</span></div>
      </div>
      {% endif %}
      {% if hook_count > 0 %}
      <div class="metric">
        <div class="label">Hook Count</div>
        <div class="value">{{ hook_count }}</div>
      </div>
      {% endif %}
      {% if memorability_score > 0 %}
      <div class="metric">
        <div class="label">Memorability</div>
        <div class="value">{{ "%.0f"|format(memorability_score * 100) }}<span class="unit"> %</span></div>
      </div>
      {% endif %}
      {% if heaviness_distortion > 0 %}
      <div class="metric">
        <div class="label">Heaviness</div>
        <div class="value">{{ "%.0f"|format(heaviness_distortion * 100) }}<span class="unit"> %</span></div>
      </div>
      {% endif %}
    </div>
  </div>

  {% if quick_stats_lufs_integrated is defined and quick_stats_lufs_integrated is not none %}
  <div class="section">
    <h2>Track Quick Stats</h2>
    <div class="metrics">
      <div class="metric">
        <div class="label">Integrated LUFS</div>
        <div class="value">{{ "%.1f"|format(quick_stats_lufs_integrated) }}<span class="unit"> LUFS</span></div>
      </div>
      <div class="metric">
        <div class="label">True Peak</div>
        <div class="value">{{ "%.1f"|format(quick_stats_true_peak) }}<span class="unit"> dBTP</span></div>
      </div>
      <div class="metric">
        <div class="label">Loudness Range</div>
        <div class="value">{{ "%.1f"|format(quick_stats_lra) }}<span class="unit"> LU</span></div>
      </div>
      <div class="metric">
        <div class="label">Crest Factor</div>
        <div class="value">{{ "%.1f"|format(quick_stats_crest) }}<span class="unit"> dB</span></div>
      </div>
      {% if quick_stats_clipping_frames is defined and quick_stats_clipping_frames > 0 %}
      <div class="metric">
        <div class="label">Clipped Frames</div>
        <div class="value" style="color:var(--accent-red);">{{ quick_stats_clipping_frames }}</div>
      </div>
      {% endif %}
      {% if quick_stats_dc_offset is defined and quick_stats_dc_offset is not none %}
      <div class="metric">
        <div class="label">DC Offset</div>
        <div class="value">{{ "%.4f"|format(quick_stats_dc_offset) }}</div>
      </div>
      {% endif %}
    </div>
  </div>
  {% endif %}

  {% if follow_up_scans %}
  <div class="section">
    <h2>Follow-up Scans</h2>
    {% for scan, fields in follow_up_scans %}
    <h3>{{ scan }}</h3>
    <div class="metrics">
      {% for label, value in fields %}
      <div class="metric">
        <div class="label">{{ label }}</div>
        <div class="value" style="font-size:1em;">{{ value }}</div>
      </div>
      {% endfor %}
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if recommendations %}
  <div class="section">
    <h2>Recommendations ({{ recommendations|length }})</h2>
    <div style="display:flex;gap:16px;margin-bottom:12px;font-size:11px;">
      <span><span style="display:inline-block;width:10px;height:10px;background:var(--accent-red);border-radius:2px;margin-right:4px;"></span>Severe (70+)</span>
      <span><span style="display:inline-block;width:10px;height:10px;background:var(--accent-amber);border-radius:2px;margin-right:4px;"></span>Moderate (40–69)</span>
      <span><span style="display:inline-block;width:10px;height:10px;background:var(--accent-blue);border-radius:2px;margin-right:4px;"></span>Minor (15–39)</span>
      <span><span style="display:inline-block;width:10px;height:10px;background:var(--accent-green);border-radius:2px;margin-right:4px;"></span>Strength (&lt;15)</span>
    </div>
    <table>
      <thead>
        <tr>
          <th style="width:70px">Severity</th>
          <th style="width:90px">Type</th>
          <th>Finding</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        {% for rec in recommendations %}
        <tr>
          <td style="{% if rec.severity >= 70 %}border-left: 4px solid var(--accent-red);{% elif rec.severity >= 40 %}border-left: 4px solid var(--accent-amber);{% elif rec.severity >= 15 %}border-left: 4px solid var(--accent-blue);{% else %}border-left: 4px solid var(--accent-green);{% endif %} padding-left: 8px;">
            {% if rec.severity >= 70 %}
            <span class="badge badge-fail">{{ rec.severity|int }}</span>
            {% elif rec.severity >= 40 %}
            <span class="badge badge-warn">{{ rec.severity|int }}</span>
            {% else %}
            <span class="badge badge-pass">{{ rec.severity|int }}</span>
            {% endif %}
          </td>
          <td style="color:var(--text-secondary);font-size:11px;text-transform:uppercase;">{{ rec.type }}</td>
          <td>{{ rec.what }}</td>
          <td style="color:var(--text-primary);">{{ rec.suggested_action }}</td>
        </tr>
        {% set show_detail = report_mode == "engineer" and (rec.most_likely_cause or rec.trade_off or rec.how_to_verify) %}
        {% if (rec.is_myth_adjacent and rec.myth_clarification) or show_detail %}
        <tr class="rec-detail">
          <td></td>
          <td colspan="3" style="font-size:11px;color:var(--text-secondary);">
            {% if rec.is_myth_adjacent and rec.myth_clarification %}<div><strong>Context:</strong> {{ rec.myth_clarification }}</div>{% endif %}
            {% if show_detail %}
              {% if rec.most_likely_cause %}<div><strong>Likely cause:</strong> {{ rec.most_likely_cause }}</div>{% endif %}
              {% if rec.trade_off %}<div><strong>Trade-off:</strong> {{ rec.trade_off }}</div>{% endif %}
              {% if rec.how_to_verify %}<div><strong>How to verify:</strong> {{ rec.how_to_verify }}</div>{% endif %}
            {% endif %}
          </td>
        </tr>
        {% endif %}
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  {% if report_mode == "engineer" and provenance_events %}
  <div class="section">
    <h2>Provenance Timeline</h2>
    <table>
      <thead>
        <tr>
          <th style="width:100px">Time (UTC)</th>
          <th style="width:180px">Event Type</th>
          <th>Summary</th>
        </tr>
      </thead>
      <tbody>
        {% for ev in provenance_events %}
        <tr>
          <td style="color:var(--text-secondary);font-size:12px;">{{ ev.created_at[11:19] if ev.created_at|length >= 19 else ev.created_at }}</td>
          <td style="color:var(--text-accent);font-weight:600;font-size:12px;text-transform:uppercase;">{{ ev.event_type }}</td>
          <td style="color:var(--text-primary);">{{ ev.summary }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  <div class="footer">Generated by Khensu Mixing Suite v0.2.x</div>
</body>
</html>
