# Google Drive sync artifacts (the repo lives in a Drive-synced folder;
# keep these out of git and purge from
# .venv with scripts/purge_drive_artifacts.ps1 when tests break)
desktop.ini

# Agent-tool runtime state. These are normally excluded per-machine via
# .git/info/exclude (which the tools write themselves), but that file is local
# and never shared - so a fresh clone has no protection. Listed here too.
#
# .claude/worktrees/ in particular is not just noise: a single abandoned agent
# worktree grew to 9.2 GB (a bundled Python runtime + venv + build tree) before
# anyone noticed. Prefer `git worktree remove` over deleting the folder, so the
# branch and its commits survive.
.claude/worktrees/
.superpowers/

# Local binary material - never commit
Model Weights/
Ui Fixes/
# Large evaluation-corpus audio/metadata 
corpus_data/*
!corpus_data/README.md
.fetchcontent/

# Performance benchmark output (scripts/bench/run_all.ps1)
bench-results/

